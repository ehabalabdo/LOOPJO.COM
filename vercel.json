    { "source": "/mijdaflogistics", "destination": "/calendar?client=mijdaflogistics", "permanent": false },
    { "source": "/sanadkom", "destination": "/calendar?client=sanadkom", "permanent": false },

    { "source": "/lp-social-media-jordan", "destination": "/social-media-jordan", "permanent": true },
