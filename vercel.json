    { "source": "/case-study/:slug*", "destination": "/portfolio", "permanent": true },
    { "source": "/projects/:slug*", "destination": "/portfolio", "permanent": true },
    { "source": "/project/:slug*", "destination": "/portfolio", "permanent": true },

    { "source": "/blog/:slug", "destination": "/blog", "permanent": true },
